# Pure Soft Restoration — environment variables
#
# In production, place this file (with real values) at /etc/puresoft.env
# with mode 0600, owned by the `puresoft` system user.
#
# Locally for `npm run dev`, copy this file to `.env.local` and fill in
# the values you want available in development.

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://puresoftrestoration.com

# --- AWS SES (transactional email) ---
# In production, prefer an EC2 IAM role with ses:SendEmail / ses:SendRawEmail.
# When using a role, leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@puresoftrestoration.com
SES_REPLY_TO=admin@puresoftrestoration.com
SES_CLAIM_NOTIFICATION_TO=admin@puresoftrestoration.com

# --- Cloudflare Turnstile (form abuse protection, optional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=puresoftrestoration.com
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Without this, the
# GA script tag is not rendered and the site emits no telemetry. The value
# is public on purpose — GA4 expects it in plain HTML.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
